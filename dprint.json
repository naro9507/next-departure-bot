{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"indentWidth": 2,
	"lineWidth": 100,
	"typescript": {
		"quoteStyle": "preferDouble",
		"trailingCommas": "all",
		"semiColons": "always"
	},
	"json": {
		"indentWidth": 2
	},
	"excludes": [
		"**/node_modules",
		"**/.wrangler",
		"**/dist",
		"**/drizzle",
		"**/*-lock.json"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.93.3.wasm",
		"https://plugins.dprint.dev/json-0.19.4.wasm"
	],
	"includes": ["**/*.{ts,json}"]
}
