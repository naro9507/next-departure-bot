{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "next-departure-bot",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-30",
	// Secrets (set via `wrangler secret put <NAME>` or .dev.vars for local dev):
	//   TURSO_DATABASE_URL    - Turso DB URL (libsql://...)
	//   TURSO_AUTH_TOKEN      - Turso auth token
	//   LINE_CHANNEL_SECRET   - LINE channel secret for webhook signature verification
	//   LINE_CHANNEL_ACCESS_TOKEN - LINE channel access token for sending messages
	//   ALEXA_APP_ID          - Alexa skill application ID
	//   ADMIN_API_TOKEN       - Bearer token for admin API
}
